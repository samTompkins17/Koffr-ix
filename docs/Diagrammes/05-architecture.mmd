flowchart TB
    user(["Utilisateur : navigateur ou mobile"])
    gw["Passerelle Nginx<br/>/ · /api/auth · /api/patrimoine · /api/inventaire"]

    web["web<br/>Laravel Blade + Tailwind<br/>appelle uniquement la passerelle"]
    auth["auth-service<br/>Comptes, rôles, structures, émission du JWT"]
    pat["patrimoine-service<br/>Biens, QR codes, transferts, PV"]
    inv["inventaire-service<br/>Campagnes, scan, écarts, photos"]

    dba[("auth_db<br/>PostgreSQL")]
    dbp[("patrimoine_db<br/>PostgreSQL")]
    dbi[("inventaire_db<br/>PostgreSQL")]

    user -->|HTTPS| gw
    gw -->|"/"| web
    web -->|"API"| gw
    gw -->|"/api/auth"| auth
    gw -->|"/api/patrimoine"| pat
    gw -->|"/api/inventaire"| inv

    auth --> dba
    pat --> dbp
    inv --> dbi

    inv -->|"REST interne : fiche du bien"| pat

    note1["JWT : signé par auth, vérifié localement par chaque service avec la clé partagée.<br/>Aucun service n'appelle auth pour traiter une requête."]
    auth -.- note1
