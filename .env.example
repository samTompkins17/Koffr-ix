# Copier ce fichier en `.env` à la racine puis renseigner JWT_SECRET.
# Le secret est partagé par les quatre services : ils signent et vérifient
# les jetons eux-mêmes, sans appeler `auth`.
JWT_SECRET=remplacer-par-un-secret-aleatoire
JWT_TTL=15

# Domaine e-mail autorisé pour la connexion (vide en démonstration).
ALLOWED_EMAIL_DOMAIN=
